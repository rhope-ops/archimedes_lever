# Python checks of docs/code-standard.md that pylint runs (syntax-error and line-too-long when
# `code-max-line-chars` is passed by scripts/check.sh; C4 file-size cap retired under DEC-LINES).
# pin: pip install pylint==4.1.4
[MAIN]
persistent=no
[MESSAGES CONTROL]
disable=all
enable=syntax-error,line-too-long
